@page "/calculator"
@rendermode InteractiveServer

<PageTitle>Калькулятор</PageTitle>

<div class="container py-2" style="max-width: 600px;">
    <h3 class="mb-3 border-bottom pb-2">Калькулятор</h3>

    <div class="card shadow-sm p-4 mb-4">
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label class="form-label fw-bold">Перше число:</label>
                <input type="number" step="any" class="form-control form-control-lg" @bind="num1" placeholder="Введіть число..." />
            </div>
            <div class="col-sm-6">
                <label class="form-label fw-bold">Друге число:</label>
                <input type="number" step="any" class="form-control form-control-lg" @bind="num2" placeholder="Введіть число..." />
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-outline-primary btn-lg flex-grow-1" @onclick="() => Calculate('+')">+</button>
            <button class="btn btn-outline-primary btn-lg flex-grow-1" @onclick="() => Calculate('-')">−</button>
            <button class="btn btn-outline-primary btn-lg flex-grow-1" @onclick="() => Calculate('*')">×</button>
            <button class="btn btn-outline-primary btn-lg flex-grow-1" @onclick="() => Calculate('/')">÷</button>
            <button class="btn btn-outline-secondary btn-lg" @onclick="Clear">C</button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0" role="alert">
                <strong>Увага!</strong> @errorMessage
            </div>
        }
        else if (result.HasValue)
        {
            <div class="alert alert-success mb-0 fs-5" role="alert">
                <strong>Результат (@lastOperation):</strong> @result.Value
            </div>
        }
    </div>

    @if (history.Count > 0)
    {
        <div class="card shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="m-0">Історія обчислень</h5>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => history.Clear()">Очистити історію</button>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var entry in history.AsEnumerable().Reverse())
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>@entry</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    private double? num1;
    private double? num2;
    private double? result;
    private string? lastOperation;
    private string? errorMessage;
    private List<string> history = new();

    private void Calculate(char op)
    {
        errorMessage = null;

        if (!num1.HasValue || !num2.HasValue)
        {
            errorMessage = "Будь ласка, введіть обидва числа.";
            result = null;
            return;
        }

        double val1 = num1.Value;
        double val2 = num2.Value;

        switch (op)
        {
            case '+':
                result = val1 + val2;
                lastOperation = $"{val1} + {val2}";
                break;
            case '-':
                result = val1 - val2;
                lastOperation = $"{val1} − {val2}";
                break;
            case '*':
                result = val1 * val2;
                lastOperation = $"{val1} × {val2}";
                break;
            case '/':
                if (val2 == 0)
                {
                    errorMessage = "Ділення на нуль неможливе!";
                    result = null;
                    return;
                }
                result = val1 / val2;
                lastOperation = $"{val1} ÷ {val2}";
                break;
        }

        if (result.HasValue)
        {
            history.Add($"{lastOperation} = {result.Value}");
        }
    }

    private void Clear()
    {
        num1 = null;
        num2 = null;
        result = null;
        lastOperation = null;
        errorMessage = null;
    }
}

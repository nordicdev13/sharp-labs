@page
@model RazorPagesCar.Pages.Cars.IndexModel

@{
    ViewData["Title"] = "Каталог авто";
}

<h1>Каталог легкових авто</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Додати авто</a>
</p>

<form method="get" class="row g-3 align-items-center mb-4">
    <div class="col-auto">
        <label class="col-form-label fw-bold">Марка:</label>
    </div>
    <div class="col-auto">
        <select asp-for="CarMake" asp-items="Model.Makes" class="form-select">
            <option value="">Всі марки</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="col-form-label fw-bold">Пошук:</label>
    </div>
    <div class="col-auto">
        <input type="text" asp-for="SearchString" class="form-control" placeholder="Введіть модель чи марку..." />
    </div>
    <div class="col-auto">
        <input type="submit" value="Фільтрувати" class="btn btn-secondary" />
        <a asp-page="./Index" class="btn btn-outline-secondary">Скинути</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Make)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].BodyType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Color)
            </th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Car) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Make)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Model)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BodyType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Color)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Редагувати</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Деталі</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>

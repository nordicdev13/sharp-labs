@page
@model RazorPagesCar.Pages.Contact.IndexModel
@{
    ViewData["Title"] = "Контактна інформація";
}

<h1 class="mb-4 fw-bold">Зворотний зв’язок</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-4">
                <h4 class="card-title fw-bold mb-3">Як з нами зв’язатися</h4>
                <p class="mb-2"><strong>Ел. пошта:</strong> <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a></p>
                <p class="mb-3"><strong>Телефон підтримки:</strong> @Model.Phone</p>
                <hr />
                <p class="text-secondary small mb-0">
                    Виникли питання щодо каталогів, помітили неточність або маєте пропозиції щодо співпраці? Надішліть нам повідомлення через форму, і адміністратор відповість вам електронною поштою.
                </p>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        @if (!string.IsNullOrEmpty(Model.OkMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @Model.OkMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title fw-bold mb-3">Надіслати звернення</h4>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Name" class="form-control" placeholder="Введіть ваше ім’я" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Email" class="form-control" placeholder="example@mail.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Subject" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Subject" class="form-control" placeholder="Тема вашого запиту" />
                    <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Message" class="form-label fw-semibold"></label>
                    <textarea asp-for="Input.Message" class="form-control" rows="5" placeholder="Опишіть ваше питання або пропозицію..."></textarea>
                    <span asp-validation-for="Input.Message" class="text-danger small"></span>
                </div>

                @* Honeypot — приховане поле для людей, але заповнюване ботами *@
                <div style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;">
                    <label for="Website">Ваш вебсайт (залиште порожнім)</label>
                    <input name="Input.Website" id="Website" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <button class="btn btn-primary px-4 py-2" type="submit">Надіслати звернення</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model RazorPagesCar.Pages.Admin.Reviews.IndexModel
@{
    ViewData["Title"] = "Відгуки (адмін)";
}

<h1 class="mb-3 fw-bold">Керування відгуками</h1>

<form method="get" class="row g-2 align-items-end mb-4 bg-light p-3 rounded shadow-sm">
    <div class="col-12 col-md-6">
        <label for="q" class="form-label fw-semibold">Пошук</label>
        <input id="q" name="q" value="@Model.q" class="form-control" placeholder="Модель авто, автор або текст відгуку..." />
    </div>
    <div class="col-6 col-md-3 form-check mb-2">
        <input class="form-check-input" type="checkbox" id="onlyUnreplied" name="onlyUnreplied" value="true" @(Model.onlyUnreplied ? "checked" : "") />
        <label class="form-check-label fw-semibold" for="onlyUnreplied">Лише без відповіді</label>
    </div>
    <div class="col-6 col-md-3">
        <button class="btn btn-primary w-100">Фільтрувати</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">Відгуків не знайдено.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>Автомобіль</th>
                    <th>Автор</th>
                    <th>Оцінка</th>
                    <th>Коментар</th>
                    <th>Відповідь адміністратора</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td><small class="text-muted">@it.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td class="fw-semibold">@it.CarTitle</td>
                        <td>@it.ReviewerName</td>
                        <td><span class="badge bg-warning text-dark">★ @it.Rating</span></td>
                        <td style="max-width:280px;">
                            @if (!string.IsNullOrWhiteSpace(it.Comment))
                            {
                                @it.Comment
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td style="max-width:280px;">
                            @if (!string.IsNullOrWhiteSpace(it.AdminReply))
                            {
                                <div class="text-dark">@it.AdminReply</div>
                                <div class="text-muted small">
                                    @if (it.AdminRepliedAt != null)
                                    {
                                        @($"відповідь: {it.AdminRepliedAt.Value.ToLocalTime():yyyy-MM-dd HH:mm}")
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Немає відповіді</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-page="./Reply" asp-route-id="@it.ReviewId">
                                @(string.IsNullOrWhiteSpace(it.AdminReply) ? "Відповісти" : "Редагувати")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
